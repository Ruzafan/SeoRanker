# ============================================================
# SEO Autopilot — variables de entorno
# Copia a .env (o ejecuta `node scripts/init-env.mjs`, que además genera los
# secretos). Cada app valida las suyas al arrancar (zod, un único env.ts por
# app): si falta o es inválida una obligatoria, el proceso no arranca y dice cuál.
# ============================================================

# --- General ---------------------------------------------------
# development | production | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Postgres (api, worker y prisma) -----------------------------
POSTGRES_USER=seo
POSTGRES_PASSWORD=seo
POSTGRES_DB=seo
# Desde el host (pnpm dev). Dentro de docker-compose se sobreescribe con host "postgres".
DATABASE_URL=postgresql://seo:seo@localhost:5432/seo?schema=public

# --- Redis (BullMQ) ---------------------------------------------
# Desde el host. Dentro de docker-compose se sobreescribe con host "redis".
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Origen del frontend permitido por CORS (el que ves en el navegador, con https en producción).
WEB_ORIGIN=http://localhost:8080
# Login: intentos por minuto y IP antes de responder 429.
LOGIN_RATE_LIMIT_MAX=10

# --- Web ---------------------------------------------------------
WEB_PORT=8080

# --- Seguridad (OBLIGATORIAS: api y worker) ----------------------
# JWT_SECRET: mínimo 32 caracteres. Genera con: openssl rand -base64 48
JWT_SECRET=
# ENCRYPTION_KEY: 32 bytes en base64 (AES-256-GCM, cifra las credenciales de WordPress).
# Genera con: openssl rand -base64 32. Si la pierdes, las credenciales guardadas son irrecuperables.
ENCRYPTION_KEY=
# Cookie de sesión con flag Secure. Por defecto: true en producción, false en desarrollo.
# Pon false SOLO si pruebas por http (sin TLS) con NODE_ENV=production.
COOKIE_SECURE=
# Permite sitios en localhost/IP privada (para probar con un WordPress local).
# Por defecto: true en desarrollo, false en producción (protección SSRF).
ALLOW_PRIVATE_HOSTS=

# --- Cuentas -----------------------------------------------------
# true | false. Con false, solo el primer usuario puede registrarse (bootstrap).
REGISTRATION_ENABLED=true
# Email con acceso a la vista de administración (todas las organizaciones, solo lectura)
# y a bull-board en /admin/queues. Vacío = ambas desactivadas.
ADMIN_EMAIL=

# --- Claude (OBLIGATORIA en el worker) ---------------------------
ANTHROPIC_API_KEY=
# Modelo por defecto; cada sitio puede sobreescribirlo en Ajustes.
DEFAULT_MODEL=claude-sonnet-5
# Tarifas para la estimación de coste: ver packages/core/src/ai/pricing.ts

# --- Keywords ----------------------------------------------------
# Opcional: añade "People Also Ask" (SerpAPI) a discover.
SERPAPI_KEY=

# --- Cuotas y rendimiento ----------------------------------------
# Tope mensual de artículos en el plan "free" (el que tienen todas las organizaciones ahora).
FREE_PLAN_MAX_ARTICLES=10
# Trabajos de redacción en paralelo por worker.
WORKER_CONCURRENCY=2
