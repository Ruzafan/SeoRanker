generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free") // free | starter | pro | agency (lo sincroniza Stripe)
  createdAt DateTime @default(now())
  users     User[]
  sites     Site[]

  // Facturación (Stripe). El plan efectivo es `plan`; esto es el estado de la suscripción.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active | trialing | past_due | canceled | unpaid | incomplete...
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  role           String       @default("owner") // owner | member
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  url            String
  platform       String       @default("wordpress") // wordpress | shopify (futuro)
  credentials    String // JSON cifrado AES-256-GCM
  brandVoice     String?      @db.Text
  language       String       @default("es")
  country        String       @default("ES")
  settings       Json         @default("{}") // wordCount, cadence, autoPublish, categoryId...
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  keywords      Keyword[]
  articles      Article[]
  jobs          JobRun[]
  usage         UsageRecord[]
  searchConsole SearchConsoleConnection?
  metrics       ArticleMetric[]
  conversions   ArticleConversion[]

  @@index([organizationId])
}

model Keyword {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  term      String
  source    String   @default("manual") // manual | autocomplete | paa | gsc | import
  intent    String? // informational | commercial | transactional
  score     Int      @default(0)
  status    String   @default("pending") // pending | queued | processing | done | failed | discarded
  seedTerm  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Métricas de mercado (proveedor de keywords, p. ej. DataForSEO) y de Search Console.
  volume         Int? // búsquedas/mes
  difficulty     Int? // 0-100
  cpc            Float? // EUR
  gscImpressions Int? // últimos 28 días
  gscClicks      Int?
  gscPosition    Float?

  articles Article[]

  @@unique([siteId, term])
  @@index([siteId, status, score])
  @@index([status, updatedAt]) // watchdog de zombis
}

model Article {
  id              String    @id @default(cuid())
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordId       String?
  keyword         Keyword?  @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  title           String
  slug            String
  metaDescription String?
  outline         Json?
  /// Top de Google para la keyword al planificar (títulos, H2 de la competencia, preguntas).
  serp            Json?
  contentHtml     String?   @db.Text
  /// Imagen destacada (ID de medio de WordPress, p. ej. la foto del producto recomendado).
  featuredMediaId Int?
  status          String    @default("draft") // draft | writing | ready | publishing | published | failed
  remotePostId    Int? // ID del post en WordPress
  remoteUrl       String?
  remoteStatus    String? // estado del post en WordPress (draft | publish | future…), lo sincroniza `sync`
  decayDetectedAt DateTime? // pierde clics en Search Console: candidato a refrescar
  wordCount       Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([siteId, status])
  @@index([status, updatedAt]) // watchdog de zombis

  metrics     ArticleMetric[]
  conversions ArticleConversion[]
}

/// Search Console de un sitio. El refresh token va cifrado (AES-256-GCM), como las credenciales de WP.
model SearchConsoleConnection {
  id          String    @id @default(cuid())
  siteId      String    @unique
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  credentials String // JSON cifrado { refreshToken }
  googleEmail String?
  propertyUrl String? // "sc-domain:tienda.es" o "https://tienda.es/"
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Rendimiento diario de un artículo en Google (Search Console).
model ArticleMetric {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  position    Float

  @@unique([articleId, date])
  @@index([siteId, date])
}

/// Pedido de WooCommerce cuya sesión empezó en un artículo (atribución por página de entrada).
model ArticleConversion {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  orderId   String
  total     Float
  currency  String
  orderedAt DateTime

  @@unique([siteId, orderId])
  @@index([siteId, orderedAt])
}

model JobRun {
  id         String    @id @default(cuid())
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type       String // discover | outline | write | publish | brand-voice
  status     String // queued | running | succeeded | failed
  refId      String? // keywordId o articleId
  attempt    Int       @default(1)
  error      String?   @db.Text
  meta       Json? // tokens, duración, modelo usado
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([siteId, createdAt])
}

model UsageRecord {
  id           String @id @default(cuid())
  siteId       String
  site         Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  period       String // "2026-09"
  articles     Int    @default(0)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  costCents    Int    @default(0)

  @@unique([siteId, period])
}
